{
  "$meta": {
    "source": "Shared native mobile design system; Arabic-first adaptive layouts, accessible contrast and restrained motion.",
    "units": "dp on Android == pt on iOS; font sizes sp == pt",
    "note": "Edit theme in this file to recolour the entire app, launch screens, icons, web and mail. Run php artisan design:tokens; platform files are generated."
  },
  "theme": {
    "$note": "All palette inputs live here. primary controls brand blue; accent controls the complementary colour and its derived shades independently. Semantic colours remain independent.",
    "primary": "#0054D5",
    "primaryContainer": {
      "mix": "{theme.primary}",
      "with": "{theme.surface}",
      "amount": 0.12
    },
    "surface": "#FFFFFF",
    "background": "#F7F8FA",
    "inset": "#F2F4F7",
    "border": "#E4E7EC",
    "ink": "#0D1C2E",
    "secondaryText": "#475569",
    "mutedText": "#64748B",
    "success": "#166534",
    "successSurface": "#ECFDF3",
    "warning": "#92400E",
    "warningSurface": "#FFFBEB",
    "danger": "#BA1A1A",
    "dangerSurface": "#FEF2F2",
    "rating": "#B7790B",
    "ratingEmpty": "#64748B",
    "onPrimary": "#FFFFFF",
    "accent": "#168B83"
  },
  "color": {
    "primary600": "{theme.primary}",
    "primary500": "{theme.primary}",
    "primary400": "{theme.primaryContainer}",
    "primary700": {
      "mix": "{theme.primary}",
      "with": "{theme.ink}",
      "amount": 0.2
    },
    "primary50": {
      "mix": "{theme.primary}",
      "with": "{theme.surface}",
      "amount": 0.94
    },
    "primary50Info": "{color.accentTint}",
    "primary50Available": "{color.successTint}",
    "navy900": "{theme.ink}",
    "navy800": "{theme.ink}",
    "slate500": "{theme.secondaryText}",
    "slate400": "{theme.secondaryText}",
    "slate300": "{theme.mutedText}",
    "border": "{theme.border}",
    "surface": "{theme.surface}",
    "surfaceAlt": "{theme.background}",
    "surfaceAlt2": "{theme.inset}",
    "scrim": {
      "hex": "{theme.ink}",
      "alpha": 0.6
    },
    "onPrimary": "{theme.onPrimary}",
    "star": "{theme.rating}",
    "starEmpty": "{theme.ratingEmpty}",
    "amber500": "{theme.warning}",
    "amber50": "{theme.warningSurface}",
    "warningBg": "{theme.warningSurface}",
    "warningText": "{theme.warning}",
    "badgeBg": "{theme.warningSurface}",
    "badgeText": "{theme.warning}",
    "danger": "{theme.danger}",
    "brandPrimary": "{theme.primary}",
    "brandSecondary": "{color.primary400}",
    "brandTint": "{color.primary50}",
    "brandBackdrop": "{color.primary700}",
    "onHeroWell": {
      "hex": "{theme.onPrimary}",
      "alpha": 0.2
    },
    "onHeroBody": {
      "hex": "{theme.onPrimary}",
      "alpha": 0.88
    },
    "urgentText": "{theme.warning}",
    "dangerTint": "{theme.dangerSurface}",
    "surfaceContainer": "{theme.inset}",
    "surfaceContainerHigh": "{theme.inset}",
    "success": "{theme.success}",
    "successTint": "{theme.successSurface}",
    "surfaceContainerHighest": "{theme.inset}",
    "primaryWellSelected": {
      "mix": "{color.primary50}",
      "with": "{theme.primary}",
      "amount": 0.15
    },
    "heroScrim": {
      "hex": "{theme.ink}",
      "alpha": 0.9
    },
    "heroScrimMid": {
      "hex": "{theme.ink}",
      "alpha": 0.4
    },
    "heroBadgeText": "{theme.onPrimary}",
    "heroBadgeBg": {
      "hex": "{color.accentText}",
      "alpha": 1
    },
    "statusPillBg": "{color.primary50}",
    "avatarRing": {
      "hex": "{theme.accent}",
      "alpha": 0.2
    },
    "secondaryButtonBg": "{color.accentTint}",
    "secondaryButtonText": "{color.accentText}",
    "secondaryButtonPressedBg": "{color.accent700}",
    "secondaryButtonPressedText": "{color.onAccent}",
    "feedbackErrorBg": "{color.dangerTint}",
    "feedbackErrorText": "{color.danger}",
    "notificationUnreadBg": "{color.primary50}",
    "notificationUnreadTitle": "{theme.ink}",
    "notificationReadTitle": "{theme.secondaryText}",
    "notificationReadBody": {
      "mix": "{theme.mutedText}",
      "with": "{theme.ink}",
      "amount": 0.08
    },
    "chipBg": "{theme.surface}",
    "chipText": "{theme.secondaryText}",
    "chipSelectedBg": "{color.primary50}",
    "chipSelectedText": "{theme.primary}",
    "infoText": "{color.accentText}",
    "infoBg": "{color.accentTint}",
    "neutralText": "{theme.secondaryText}",
    "neutralBg": "{theme.inset}",
    "verifiedText": "{theme.success}",
    "verifiedBg": "{theme.successSurface}",
    "accent": "{theme.accent}",
    "accentText": {
      "mix": "{theme.accent}",
      "with": "{theme.ink}",
      "amount": 0.18
    },
    "accent700": {
      "mix": "{theme.accent}",
      "with": "{theme.ink}",
      "amount": 0.3
    },
    "accentTint": {
      "mix": "{theme.accent}",
      "with": "{theme.surface}",
      "amount": 0.91
    },
    "accentBorder": {
      "mix": "{theme.accent}",
      "with": "{theme.surface}",
      "amount": 0.65
    },
    "onAccent": "{theme.onPrimary}",
    "disabledBg": "{theme.border}",
    "disabledText": "{theme.secondaryText}",
    "amountText": "{theme.ink}",
    "decorativeIcon": "{color.accentText}"
  },
  "font": {
    "family": "IBM Plex Sans Arabic",
    "source": "Figma Primo App (owner decision 2026-10-09, closes OD-07)",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "files": {
      "regular": "IBMPlexSansArabic-Regular",
      "medium": "IBMPlexSansArabic-Medium",
      "semibold": "IBMPlexSansArabic-SemiBold",
      "bold": "IBMPlexSansArabic-Bold"
    }
  },
