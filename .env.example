APP_NAME="بازار"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bzr.noox.test
APP_TIMEZONE=UTC

# المنطقة الزمنية المعروضة في اللوحة والتطبيقات (الأوقات تُخزَّن UTC — 29)
APP_DISPLAY_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bzr_ddb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bzr.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── مفاتيح المرحلة (39-OPERATING-MODES) ──────────────────────────────
# القيم الحقيقية تُقرأ من جدول settings؛ هذه بذور التهيئة الأولى فقط.
BZR_OFFERS_ENABLED=false
BZR_INSPECTION_FEE_ENABLED=false

# ── تكاملات (DEC-036، DEC-038) ───────────────────────────────────────
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
GOOGLE_MAPS_SERVER_KEY=
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
