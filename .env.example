APP_NAME="بريمو - Bremo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# DEC-048: الدومين bremo والامتداد من هنا. كل بريد ورابط عام يُشتق منه.
APP_DOMAIN=bremo.test
APP_URL="https://${APP_DOMAIN}"
APP_TIMEZONE=UTC

# المنطقة الزمنية المعروضة في اللوحة والتطبيقات (الأوقات تُخزَّن UTC — 29)
APP_DISPLAY_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bzr_ddb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# DEC-049: ZeptoMail. الإنتاج: MAIL_MAILER=zeptomail (API) أو smtp (smtp.zeptomail.com:587، اسم المستخدم emailapikey).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.zeptomail.com
MAIL_PORT=587
MAIL_USERNAME=emailapikey
MAIL_PASSWORD=null
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_KEY=null
# العناوين الافتراضية no-reply@${APP_DOMAIN} و support@${APP_DOMAIN}؛ اضبطهما هنا فقط عند الحاجة.
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── مفاتيح المرحلة (39-OPERATING-MODES) ──────────────────────────────
# القيم الحقيقية تُقرأ من جدول settings؛ هذه بذور التهيئة الأولى فقط.
BZR_OFFERS_ENABLED=false
BZR_INSPECTION_FEE_ENABLED=false

# ── عقد تطبيقات الهاتف (31) ──────────────────────────────────────────
DESIGN_TOKENS_VERSION=1
MINIMUM_ANDROID_APP_VERSION=1.0.0
MINIMUM_IOS_APP_VERSION=1.0.0

# ── تكاملات (DEC-036، DEC-038) ───────────────────────────────────────
PAYMENT_GATEWAY_DRIVER=staging
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_CHECKOUT_URL=https://staging-pay.example.test/checkout
GOOGLE_MAPS_SERVER_KEY=
MAPS_ANDROID_API_KEY=
GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes
# DEC-058 — fcm في staging/production؛ log للتطوير فقط. ملف حساب الخدمة خارج git.
PUSH_DRIVER=log
FCM_PROJECT_ID=bremoapp-a8b4d
FCM_CREDENTIALS_PATH=
# بصمات SHA-256 لشهادات الإصدار مفصولة بفواصل، وTeam ID لـUniversal Links (DEP-LINK-01)
ANDROID_APP_LINK_SHA256=
APPLE_TEAM_ID=
