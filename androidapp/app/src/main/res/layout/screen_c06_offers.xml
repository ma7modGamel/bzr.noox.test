<?xml version="1.0" encoding="utf-8"?>
<!-- SCR-C06 — Figma «Primo App» offers 3002:446 (DEC-073). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_s"
        android:orientation="vertical"
        android:showDividers="middle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/bremo_gap_s"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:showDividers="middle">

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Bremo.DetailStrong" />

            <View
                android:layout_width="@dimen/bremo_size_status_dot"
                android:layout_height="@dimen/bremo_size_status_dot"
                android:background="@drawable/bremo_bg_online_dot" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/requestPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bremo_bg_status_pill"
                android:drawablePadding="@dimen/bremo_space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/bremo_space_m"
                android:paddingVertical="@dimen/bremo_space_xs"
                android:textAppearance="@style/TextAppearance.Bremo.StatusPill"
                app:drawableStartCompat="@drawable/ic_wrench"
                app:drawableTint="@color/bremo_primary600" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offers_headline"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Bremo.ScreenTitle" />

        <TextView
            android:id="@+id/paymentNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/bremo_space_xs"
            android:text="@string/offers_payment_note"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Bremo.LinkSmall"
            app:drawableStartCompat="@drawable/ic_shield"
            app:drawableTint="@color/bremo_primary600" />
    </LinearLayout>

    <noox.bzr.design.views.SortChipsView
        android:id="@+id/sort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/offerList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_xl"
        android:orientation="vertical"
        android:showDividers="middle" />

    <noox.bzr.design.views.EmptyStateView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:bremoBody="@string/offers_empty_body"
        app:bremoTitle="@string/offers_empty_title" />

    <noox.bzr.customer.ActionButtonsView
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</merge>
