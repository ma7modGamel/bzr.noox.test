<?xml version="1.0" encoding="utf-8"?>
<!-- C01 service tile (Figma 3002:270): tinted card, white icon well, label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bremo_bg_home_tile"
    android:divider="@drawable/bremo_gap_s"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/bremo_space_m"
    android:showDividers="middle">

    <FrameLayout
        android:id="@+id/well"
        android:layout_width="@dimen/bremo_size_home_tile_well"
        android:layout_height="@dimen/bremo_size_home_tile_well"
        android:background="@drawable/bremo_bg_home_well">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/bremo_size_icon"
            android:layout_height="@dimen/bremo_size_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Bremo.TileLabel" />
</LinearLayout>
