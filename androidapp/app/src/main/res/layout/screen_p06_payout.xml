<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" tools:parentTag="android.widget.LinearLayout">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/provider_onboarding_step_5" android:textAppearance="@style/TextAppearance.Bremo.Caption" />
    <LinearLayout android:id="@+id/methods" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:divider="@drawable/bremo_gap_s" android:showDividers="middle" />
    <noox.bzr.design.views.AppTextFieldView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <noox.bzr.design.views.SummaryCardView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" app:bremoTitle="@string/provider_onboarding_summary" />
    <noox.bzr.design.views.InfoBannerView android:layout_width="match_parent" android:layout_height="wrap_content" app:bremoText="@string/provider_onboarding_review_note" />
    <noox.bzr.design.views.WarningBoxView android:id="@+id/validation" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <noox.bzr.design.views.PrimaryButtonView android:id="@+id/submit" android:layout_width="match_parent" android:layout_height="wrap_content" app:bremoText="@string/action_submit_provider_application" />
</merge>
