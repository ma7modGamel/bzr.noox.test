<?xml version="1.0" encoding="utf-8"?>
<!-- Figma «Primo App» «طلباتي» 3002:3889 — the tabs and order cards are built in C25OrdersView (DEC-076). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <noox.bzr.design.views.EmptyStateView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/orders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_l"
        android:orientation="vertical"
        android:showDividers="middle" />

    <TextView
        android:id="@+id/loadingMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/orders_loading_more"
        android:textAppearance="@style/TextAppearance.Bremo.Secondary"
        android:visibility="gone" />
</merge>
