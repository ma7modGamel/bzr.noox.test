<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/bremo_space_m"
        android:background="@drawable/bg_address_card"
        android:foreground="?attr/selectableItemBackground"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/locationIcon"
                android:layout_width="@dimen/bremo_size_icon"
                android:layout_height="@dimen/bremo_size_icon"
                android:layout_marginEnd="@dimen/bremo_space_s"
                android:src="@drawable/ic_location"
                android:tint="@color/bremo_primary600"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Bremo.TileTitle"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/primaryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Bremo.Caption"
                    android:textColor="@color/bremo_primary600"
                    android:text="@string/address_default_badge"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/progress"
                android:layout_width="@dimen/bremo_size_touch_target_min"
                android:layout_height="@dimen/bremo_size_touch_target_min"
                android:visibility="gone">
                <ProgressBar
                    android:layout_width="@dimen/bremo_size_icon"
                    android:layout_height="@dimen/bremo_size_icon"
                    android:layout_gravity="center" />
            </FrameLayout>

            <noox.bzr.design.views.IconSquareButtonView
                android:id="@+id/actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bremo_space_xs"
            android:textAppearance="@style/TextAppearance.Bremo.Secondary"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</merge>
