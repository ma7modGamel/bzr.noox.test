<?xml version="1.0" encoding="utf-8"?>
<!-- Single activity (DEC-047): every screen is a Fragment in nav_graph. RTL is mandatory.
     DEC-062: the customer bottom navigation stays under the four tab screens, so its animation plays between them;
     the ball rises over the screen above it, hence clipChildren off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bremo_surface"
    android:clipChildren="false"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <noox.bzr.design.views.BottomNavView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
