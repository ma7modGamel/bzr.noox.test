<?xml version="1.0" encoding="utf-8"?>
<!-- SCR-C37 step 2 of 5 — describe the problem (DEC-071, Figma 3002:144). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- The chosen service, with a way back to step 1. -->
    <LinearLayout
        android:id="@+id/servicePill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bremo_bg_card"
        android:divider="@drawable/bremo_gap_s"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/bremo_space_l"
        android:paddingVertical="@dimen/bremo_space_s"
        android:showDividers="middle">

        <ImageView
            android:id="@+id/serviceIcon"
            android:layout_width="@dimen/bremo_size_icon_small"
            android:layout_height="@dimen/bremo_size_icon_small"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/request_service_selected"
            android:textAppearance="@style/TextAppearance.Bremo.Hint" />

        <TextView
            android:id="@+id/serviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Bremo.Body"
            android:textStyle="bold" />

        <noox.bzr.design.views.LinkButtonView
            android:id="@+id/editService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:bremoText="@string/common_edit" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/request_problem_type"
        android:textAppearance="@style/TextAppearance.Bremo.SectionTitle" />

    <noox.bzr.design.views.TileGridLayout
        android:id="@+id/problemList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <noox.bzr.design.views.TextAreaFieldView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoLabel="@string/request_description_label"
        app:bremoPlaceholder="@string/request_description_placeholder" />

    <TextView
        android:id="@+id/descriptionHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/bremo_space_xs"
        android:text="@string/request_description_hint"
        android:textAppearance="@style/TextAppearance.Bremo.Hint"
        app:drawableStartCompat="@drawable/ic_lightbulb"
        app:drawableTint="@color/bremo_primary600" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/request_media_title"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Bremo.SectionTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/request_media_optional"
            android:textAppearance="@style/TextAppearance.Bremo.Hint" />
    </LinearLayout>

    <noox.bzr.design.views.TileGridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoMaxColumns="3"
        app:bremoMinColumnWidth="@dimen/bremo_size_action_pill_min_width">

        <noox.bzr.design.views.ActionPillView
            android:id="@+id/addPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:bremoIcon="@drawable/ic_camera"
            app:bremoText="@string/request_media_photo" />

        <noox.bzr.design.views.ActionPillView
            android:id="@+id/addVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:bremoIcon="@drawable/ic_video"
            app:bremoText="@string/request_media_video" />

        <noox.bzr.design.views.ActionPillView
            android:id="@+id/addAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:bremoIcon="@drawable/ic_mic"
            app:bremoText="@string/media_audio" />
    </noox.bzr.design.views.TileGridLayout>

    <TextView
        android:id="@+id/attachmentsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Bremo.Caption" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/attachments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:divider="@drawable/bremo_gap_m"
            android:orientation="horizontal"
            android:showDividers="middle" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/privacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/bremo_space_xs"
        android:gravity="center"
        android:text="@string/request_media_privacy"
        android:textAppearance="@style/TextAppearance.Bremo.Hint"
        app:drawableStartCompat="@drawable/ic_shield"
        app:drawableTint="@color/bremo_primary600" />

    <noox.bzr.design.views.PrimaryButtonView
        android:id="@+id/next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoIcon="@drawable/ic_arrow_forward"
        app:bremoText="@string/request_step2_action" />
</merge>
