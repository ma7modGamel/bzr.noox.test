<?xml version="1.0" encoding="utf-8"?>
<!-- SCR-C15 C15AddressFormScreen content (DEC-047). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <noox.bzr.design.views.MapCardView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoTitle="@string/address_map_title" />

    <TextView
        android:id="@+id/areaTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Bremo.SectionTitle"
        android:text="@string/address_area_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/areas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <noox.bzr.design.views.AppTextFieldView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoLabel="@string/address_field_label"
        app:bremoPlaceholder="@string/address_field_label_placeholder" />

    <noox.bzr.design.views.AppTextFieldView
        android:id="@+id/details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoLabel="@string/address_field_details"
        app:bremoPlaceholder="@string/address_field_details_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:divider="@drawable/bremo_gap_m"
        android:showDividers="middle">

        <noox.bzr.design.views.AppTextFieldView
            android:id="@+id/building"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:bremoLabel="@string/address_field_building"
            app:bremoPlaceholder="@string/address_field_building" />

        <noox.bzr.design.views.AppTextFieldView
            android:id="@+id/floor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:bremoLabel="@string/address_field_floor"
            app:bremoPlaceholder="@string/address_field_floor" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:divider="@drawable/bremo_gap_m"
        android:showDividers="middle">

        <noox.bzr.design.views.AppTextFieldView
            android:id="@+id/apartment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:bremoLabel="@string/address_field_apartment"
            app:bremoPlaceholder="@string/address_field_apartment" />

        <noox.bzr.design.views.AppTextFieldView
            android:id="@+id/landmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:bremoLabel="@string/address_field_landmark"
            app:bremoPlaceholder="@string/address_field_landmark" />

    </LinearLayout>

    <noox.bzr.design.views.CheckRowView
        android:id="@+id/isDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoText="@string/address_default" />

    <noox.bzr.design.views.InfoBannerView
        android:id="@+id/areaRequired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:bremoText="@string/address_validation_area_required" />

    <noox.bzr.design.views.InfoBannerView
        android:id="@+id/locationRequired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:bremoText="@string/address_validation_location_required" />

    <noox.bzr.design.views.InfoBannerView
        android:id="@+id/unserved"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:bremoText="@string/address_validation_unserved_area" />

    <noox.bzr.design.views.PrimaryButtonView
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoText="@string/common_save" />
</merge>
