<?xml version="1.0" encoding="utf-8"?>
<!-- Figma «Primo App» «قيّم الخدمة» 3002:4475 — the cards are built in C24RatingView (DEC-076). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_l"
        android:orientation="vertical"
        android:showDividers="middle" />

    <noox.bzr.design.views.TextAreaFieldView
        android:id="@+id/comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoPlaceholder="@string/rating_notes" />

    <noox.bzr.design.views.InfoBannerView
        android:id="@+id/success"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:bremoText="@string/rating_success" />

    <noox.bzr.design.views.WarningBoxView
        android:id="@+id/warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_xs"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:showDividers="middle">

        <noox.bzr.design.views.PrimaryButtonView
            android:id="@+id/submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:bremoText="@string/rating_submit" />

        <TextView
            android:id="@+id/after_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/rating_after_submit"
            android:textAppearance="@style/TextAppearance.Bremo.Hint" />
    </LinearLayout>
</merge>
