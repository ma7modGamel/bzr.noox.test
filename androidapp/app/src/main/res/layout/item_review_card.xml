<?xml version="1.0" encoding="utf-8"?>
<!-- C05 review card (Figma 3002:1401): icon well, title and lines, «تعديل» back to the step. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bremo_bg_card"
    android:divider="@drawable/bremo_gap_m"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/bremo_space_l"
    android:showDividers="middle">

    <FrameLayout
        android:layout_width="@dimen/bremo_size_review_well"
        android:layout_height="@dimen/bremo_size_review_well"
        android:background="@drawable/bremo_bg_icon_well">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/bremo_size_icon"
            android:layout_height="@dimen/bremo_size_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/bremo_primary600" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:divider="@drawable/bremo_gap_xs"
        android:orientation="vertical"
        android:showDividers="middle">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Bremo.CardTitle" />

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Bremo.Secondary" />

        <TextView
            android:id="@+id/extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Bremo.Hint" />
    </LinearLayout>

    <TextView
        android:id="@+id/edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bremo_bg_pill"
        android:foreground="?attr/selectableItemBackground"
        android:minHeight="@dimen/bremo_size_sort_chip_height"
        android:gravity="center"
        android:paddingHorizontal="@dimen/bremo_space_m"
        android:text="@string/common_edit"
        android:textAppearance="@style/TextAppearance.Bremo.LinkSmall" />
</LinearLayout>
