<?xml version="1.0" encoding="utf-8"?>
<!-- SCR-C08 — Figma «Primo App» «تأكيد اختيار الفني» 3002:1757 (DEC-073). Cards are filled in C08OfferDetailsView. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_l"
        android:orientation="vertical"
        android:showDividers="middle" />

    <!-- Bottom dock (pinned). -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_xs"
        android:orientation="vertical"
        android:showDividers="middle">

        <noox.bzr.design.views.PrimaryButtonView
            android:id="@+id/confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:bremoIcon="@drawable/ic_arrow_forward" />

        <TextView
            android:id="@+id/back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bremo_size_touch_target_min"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/confirm_back"
            android:textAppearance="@style/TextAppearance.Bremo.Caption" />
    </LinearLayout>
</merge>
