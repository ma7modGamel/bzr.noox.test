{"data":{"version":2,"locale":"ar","title":"\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645","body":"<p>\u062a\u0646\u0638\u0651\u0645 \u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u0648\u0637 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0637\u0628\u064a\u0642 \u0628\u0631\u064a\u0645\u0648 \u0648\u062e\u062f\u0645\u0627\u062a\u0647. \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0625\u0631\u0633\u0627\u0644 \u0637\u0644\u0628 \u062e\u062f\u0645\u0629 \u064a\u0639\u0646\u064a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0639\u0644\u0649 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0625\u0644\u063a\u0627\u0621 \u0648\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629.<\/p>\n<h2>\u0627\u0644\u062e\u062f\u0645\u0629<\/h2>\n<p>\u0628\u0631\u064a\u0645\u0648 \u0645\u0646\u0635\u0629 \u0644\u0637\u0644\u0628 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0646\u0632\u0644\u064a\u0629 (\u0633\u0628\u0627\u0643\u0629\u060c \u0643\u0647\u0631\u0628\u0627\u0621\u060c \u062a\u0643\u064a\u064a\u0641\u0627\u062a\u060c \u0648\u063a\u064a\u0631\u0647\u0627). \u0641\u064a \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u064a\u064f\u0646\u0641\u0651\u0630 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0641\u0646\u064a\u0648\u0646 \u062a\u0627\u0628\u0639\u0648\u0646 \u0644\u0644\u0645\u0646\u0635\u0629\u060c \u0648\u064a\u0639\u064a\u0651\u0646 \u0641\u0631\u064a\u0642 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0641\u0646\u064a \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0644\u0643\u0644 \u0637\u0644\u0628 \u062d\u0633\u0628 \u0627\u0644\u0641\u0626\u0629 \u0648\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0648\u0627\u0644\u0645\u0648\u0639\u062f.<\/p>\n<h2>\u0627\u0644\u062d\u0633\u0627\u0628<\/h2>\n<ul>\n<li>\u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0628\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631\u060c \u0648\u064a\u0644\u0632\u0645 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0628\u0631\u064a\u062f \u0642\u0628\u0644 \u0625\u0631\u0633\u0627\u0644 \u0623\u064a \u0637\u0644\u0628.<\/li>\n<li>\u0635\u0627\u062d\u0628 \u0627\u0644\u062d\u0633\u0627\u0628 \u0645\u0633\u0624\u0648\u0644 \u0639\u0646 \u0635\u062d\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0647 \u0648\u0633\u0631\u064a\u0629 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631.<\/li>\n<li>\u0644\u0644\u0625\u062f\u0627\u0631\u0629 \u0625\u064a\u0642\u0627\u0641 \u0623\u0648 \u062d\u0638\u0631 \u0627\u0644\u062d\u0633\u0627\u0628 \u0639\u0646\u062f \u0645\u062e\u0627\u0644\u0641\u0629 \u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u0648\u0637\u060c \u0645\u0639 \u0630\u0643\u0631 \u0627\u0644\u0633\u0628\u0628.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u0637\u0644\u0628 \u0648\u0627\u0644\u0645\u0648\u0639\u062f<\/h2>\n<ul>\n<li>\u064a\u062d\u062f\u062f \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u062e\u062f\u0645\u0629 \u0648\u0646\u0648\u0639 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0648\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0648\u0627\u0644\u0645\u0648\u0639\u062f (\u0627\u0644\u0622\u0646 \u0623\u0648 \u0641\u062a\u0631\u0629 \u0645\u062c\u062f\u0648\u0644\u0629)\u060c \u0648\u064a\u0645\u0643\u0646\u0647 \u0625\u0636\u0627\u0641\u0629 \u0648\u0635\u0641 \u0648\u0635\u0648\u0631 \u0648\u0641\u064a\u062f\u064a\u0648 \u0648\u062a\u0633\u062c\u064a\u0644 \u0635\u0648\u062a\u064a.<\/li>\n<li>\u064a\u0645\u0643\u0646 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0637\u0644\u0628 \u0645\u0627 \u062f\u0627\u0645 \u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u062a\u0639\u064a\u064a\u0646.<\/li>\n<li>\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0641\u062a\u0648\u062d\u0629 \u0641\u064a \u0648\u0642\u062a \u0648\u0627\u062d\u062f \u064a\u062d\u062f\u062f\u0647 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u0645\u0639\u0627\u064a\u0646\u0629 \u0648\u0627\u0644\u0633\u0639\u0631<\/h2>\n<ul>\n<li>\u0643\u0644 \u0637\u0644\u0628 \u064a\u0628\u062f\u0623 \u0628\u0632\u064a\u0627\u0631\u0629 \u0645\u0639\u0627\u064a\u0646\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629.<\/li>\n<li>\u0628\u0639\u062f \u0627\u0644\u0645\u0639\u0627\u064a\u0646\u0629 \u064a\u0642\u062f\u0651\u0645 \u0627\u0644\u0641\u0646\u064a \u0639\u0631\u0636 \u062a\u0646\u0641\u064a\u0630 \u0628\u0633\u0639\u0631 \u0627\u0644\u0645\u0635\u0646\u0639\u064a\u0629 \u0648\u0627\u0644\u062e\u0627\u0645\u0627\u062a\u060c \u0648\u0644\u0627 \u064a\u0628\u062f\u0623 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0625\u0644\u0627 \u0628\u0639\u062f \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644 \u0645\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.<\/li>\n<li>\u0631\u0641\u0636 \u0639\u0631\u0636 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u064a\u064f\u063a\u0644\u0642 \u0627\u0644\u0637\u0644\u0628 \u062f\u0648\u0646 \u0623\u064a \u0645\u0628\u0644\u063a.<\/li>\n<li>\u0623\u064a \u062a\u0643\u0644\u0641\u0629 \u0625\u0636\u0627\u0641\u064a\u0629 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u062a\u064f\u0639\u0631\u0636 \u0643\u0645\u0642\u062a\u0631\u062d \u0633\u0639\u0631\u060c \u0648\u064a\u062a\u0648\u0642\u0641 \u0627\u0644\u0628\u0646\u062f \u062d\u062a\u0649 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644\u060c \u0648\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647 \u0623\u0648\u0644\u064b\u0627 \u0644\u0627 \u064a\u062a\u063a\u064a\u0631. \u0627\u0644\u0645\u0642\u062a\u0631\u062d \u0627\u0644\u0630\u064a \u0644\u0627 \u064a\u064f\u0631\u062f \u0639\u0644\u064a\u0647 \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u0647\u0644\u0629 \u064a\u064f\u0639\u062a\u0628\u0631 \u0645\u0631\u0641\u0648\u0636\u064b\u0627.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u062f\u0641\u0639<\/h2>\n<ul>\n<li>\u0627\u0644\u062f\u0641\u0639 \u0628\u0639\u062f \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0641\u0642\u0637\u060c \u0628\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0627\u0644\u0638\u0627\u0647\u0631 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0643\u0627\u0645\u0644\u064b\u0627\u060c \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u062f\u0641\u0639 \u062c\u0632\u0626\u064a.<\/li>\n<li>\u0637\u0631\u0642 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u062a\u0638\u0647\u0631 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642: \u0646\u0642\u062f\u064b\u0627 \u0644\u0644\u0641\u0646\u064a\u060c \u0623\u0648 \u062a\u062d\u0648\u064a\u0644 \u0625\u0646\u0633\u062a\u0627\u0628\u0627\u064a \u0625\u0644\u0649 \u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0646\u0635\u0629 \u064a\u0624\u0643\u062f\u0647 \u0641\u0631\u064a\u0642 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0628\u0639\u062f \u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0628\u0644\u063a.<\/li>\n<li>\u0644\u0627 \u064a\u062d\u0641\u0638 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0628\u0646\u0643\u064a\u0629.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u0625\u0646\u0647\u0627\u0621 \u0648\u0627\u0644\u062a\u0623\u0643\u064a\u062f<\/h2>\n<ul>\n<li>\u0628\u0639\u062f \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0646\u0642\u062f\u064a \u064a\u0624\u0643\u062f \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u0648\u0625\u0646 \u0644\u0645 \u064a\u0624\u0643\u062f \u064a\u064f\u063a\u0644\u0642 \u0627\u0644\u0637\u0644\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0628\u0639\u062f \u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642.<\/li>\n<li>\u0639\u0646\u062f \u0648\u062c\u0648\u062f \u0645\u0634\u0643\u0644\u0629 \u064a\u0645\u0643\u0646 \u00ab\u0641\u062a\u062d \u0645\u0634\u0643\u0644\u0629\u00bb \u0645\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0646 \u0648\u0642\u062a \u0648\u0635\u0648\u0644 \u0627\u0644\u0641\u0646\u064a \u0648\u062d\u062a\u0649 72 \u0633\u0627\u0639\u0629 \u0628\u0639\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0637\u0644\u0628\u060c \u0648\u062a\u0631\u0627\u062c\u0639\u0647\u0627 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0648\u062a\u0642\u0631\u0631 \u0641\u064a\u0647\u0627.<\/li>\n<li>\u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f\u060c \u0625\u0646 \u062a\u0642\u0631\u0631\u060c \u064a\u0643\u0648\u0646 \u0628\u0642\u0631\u0627\u0631 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0641\u064a \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u0645\u0641\u062a\u0648\u062d\u0629 \u0648\u0644\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u062a\u0642\u064a\u064a\u0645<\/h2>\n<p>\u064a\u0642\u064a\u0651\u0645 \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0641\u0646\u064a \u0648\u0627\u0644\u0641\u0646\u064a \u0627\u0644\u0639\u0645\u064a\u0644 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0644\u0643\u0644 \u0637\u0644\u0628 \u0645\u0643\u062a\u0645\u0644 \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629\u060c \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0628\u0639\u062f \u0625\u0631\u0633\u0627\u0644\u0647. \u0644\u0644\u0625\u062f\u0627\u0631\u0629 \u0625\u062e\u0641\u0627\u0621 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0645\u0633\u064a\u0621.<\/p>\n<h2>\u0627\u0644\u062a\u0648\u0627\u0635\u0644<\/h2>\n<ul>\n<li>\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0628\u064a\u0646 \u0627\u0644\u0639\u0645\u064a\u0644 \u0648\u0627\u0644\u0641\u0646\u064a \u0628\u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u0642\u0637. \u062a\u062a\u0648\u0644\u0649 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0646\u062f \u0627\u0644\u062d\u0627\u062c\u0629 \u0648\u0645\u062a\u0627\u0628\u0639\u0629 \u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0637\u0644\u0628.<\/li>\n<li>\u0645\u0645\u0646\u0648\u0639 \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0639\u0644\u0649 \u062a\u0646\u0641\u064a\u0630 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0646\u0635\u0629 \u0623\u0648 \u0625\u0633\u0627\u0621\u0629 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0623\u064a \u0637\u0631\u0641.<\/li>\n<\/ul>\n<h2>\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0634\u0631\u0648\u0637<\/h2>\n<p>\u0639\u0646\u062f \u0646\u0634\u0631 \u0646\u0633\u062e\u0629 \u062c\u062f\u064a\u062f\u0629 \u0645\u0646 \u0627\u0644\u0634\u0631\u0648\u0637 \u064a\u064f\u0637\u0644\u0628 \u0645\u0646 \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u064a\u0647\u0627 \u0639\u0646\u062f \u0623\u0648\u0644 \u0637\u0644\u0628 \u0628\u0639\u062f \u0633\u0631\u064a\u0627\u0646\u0647\u0627\u060c \u0648\u064a\u064f\u062d\u0641\u0638 \u0631\u0642\u0645 \u0627\u0644\u0646\u0633\u062e\u0629 \u0648\u0648\u0642\u062a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0645\u0639 \u0643\u0644 \u0637\u0644\u0628.<\/p>\n<h2>\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0627\u0644\u062f\u0639\u0645<\/h2>\n<p>\u0645\u0646 \u0