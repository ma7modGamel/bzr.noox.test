9 \u0648\u0627\u0644\u0648\u0635\u0641 \u0648\u0627\u0644\u0645\u0648\u0639\u062f\u060c \u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0648\u0627\u0644\u062a\u0633\u062c\u064a\u0644\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0627\u0644\u0645\u0631\u0641\u0642\u0629 (\u062a\u064f\u0632\u0627\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0636\u0645\u0646\u0629 \u0641\u064a \u0627\u0644\u0635\u0648\u0631).<\/li>\n<li><strong>\u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a:<\/strong> \u0646\u0635 \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0648\u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u0645\u0631\u0633\u0644\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.<\/li>\n<li><strong>\u0627\u0644\u062f\u0641\u0639:<\/strong> \u0627\u0644\u0645\u0628\u0627\u0644\u063a \u0648\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639 \u0648\u0645\u0631\u0627\u062c\u0639 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0641\u0642\u0637. \u0639\u0646\u062f \u062a\u062d\u0648\u064a\u0644 \u0625\u0646\u0633\u062a\u0627\u0628\u0627\u064a: \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0631\u062c\u0639\u064a \u0644\u0644\u062a\u062d\u0648\u064a\u0644 \u0648\u0635\u0648\u0631\u0629 \u0627\u0644\u0625\u064a\u0635\u0627\u0644 \u0627\u0644\u0625\u0644\u0632\u0627\u0645\u064a\u0629. \u0644\u0627 \u062a\u064f\u062d\u0641\u0638 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a.<\/li>\n<li><strong>\u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a<\/strong> \u0627\u0644\u062a\u064a \u064a\u0643\u062a\u0628\u0647\u0627 \u0627\u0644\u0637\u0631\u0641\u0627\u0646.<\/li>\n<li><strong>\u0644\u0644\u0641\u0646\u064a\u064a\u0646:<\/strong> \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0647\u0648\u064a\u0629 \u0648\u0627\u0644\u0635\u0648\u0631\u0629 (\u062a\u062e\u0632\u064a\u0646 \u062e\u0627\u0635 \u0644\u0644\u0625\u062f\u0627\u0631\u0629 \u0641\u0642\u0637)\u060c \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0644\u0645\u0633\u062a\u062d\u0642\u0627\u062a (\u0645\u0634\u0641\u0651\u0631\u0629)\u060c \u0648\u0645\u0648\u0642\u0639 \u0627\u0644\u0641\u0646\u064a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0648\u062c\u0647 \u0644\u0644\u0639\u0645\u064a\u0644 \u0641\u0642\u0637.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u0645\u0648\u0642\u0639<\/h2>\n<ul>\n<li>\u064a\u064f\u0631\u0633\u0644 \u0645\u0648\u0642\u0639 \u0627\u0644\u0641\u0646\u064a \u0643\u0644 30 \u062b\u0627\u0646\u064a\u0629 \u062a\u0642\u0631\u064a\u0628\u064b\u0627 \u0623\u062b\u0646\u0627\u0621 \u062d\u0627\u0644\u0629 \u00ab\u0641\u064a \u0627\u0644\u0637\u0631\u064a\u0642\u00bb \u0641\u0642\u0637\u060c \u0648\u064a\u0631\u0627\u0647 \u0627\u0644\u0639\u0645\u064a\u0644 \u0635\u0627\u062d\u0628 \u0627\u0644\u0637\u0644\u0628 \u0648\u062d\u062f\u0647.<\/li>\n<li>\u0646\u0642\u0627\u0637 \u0627\u0644\u0645\u0633\u0627\u0631 \u062a\u064f\u062d\u0630\u0641 \u0639\u0646\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0637\u0644\u0628 \u0623\u0648 \u0625\u0644\u063a\u0627\u0626\u0647. \u0646\u0642\u0637\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 \u062a\u064f\u062d\u0641\u0638 90 \u064a\u0648\u0645\u064b\u0627 \u0644\u062d\u0644 \u0623\u064a \u062e\u0644\u0627\u0641.<\/li>\n<\/ul>\n<h2>\u0645\u0646 \u064a\u0631\u0649 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a<\/h2>\n<ul>\n<li><strong>\u0642\u0628\u0644 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0637\u0644\u0628<\/strong> \u0644\u0627 \u064a\u0631\u0649 \u0627\u0644\u0641\u0646\u064a \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a \u0648\u0644\u0627 \u0627\u0644\u0647\u0627\u062a\u0641\u060c \u0628\u0644 \u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0641\u0642\u0637.<\/li>\n<li><strong>\u0628\u0639\u062f \u0627\u0644\u062a\u0623\u0643\u064a\u062f<\/strong> \u064a\u0631\u0649 \u0627\u0644\u0641\u0646\u064a \u0627\u0644\u0645\u0639\u064a\u064e\u0651\u0646 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a \u0627\u0644\u0644\u0627\u0632\u0645 \u0644\u0644\u0632\u064a\u0627\u0631\u0629\u060c \u0648\u0644\u0627 \u064a\u0639\u0631\u0636 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u0623\u064a \u0637\u0631\u0641 \u0644\u0644\u0637\u0631\u0641 \u0627\u0644\u0622\u062e\u0631. \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0628\u064a\u0646 \u0627\u0644\u0639\u0645\u064a\u0644 \u0648\u0627\u0644\u0641\u0646\u064a \u0628\u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0641\u0642\u0637\u060c \u0648\u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u062a\u062a\u0648\u0644\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a \u0628\u0627\u0644\u0639\u0645\u064a\u0644.<\/li>\n<li>\u0641\u064a \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u062a\u064f\u062d\u062c\u0628 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0648\u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0648\u0627\u0644\u0628\u0631\u064a\u062f \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0637\u0648\u0627\u0644 \u0631\u062d\u0644\u0629 \u0627\u0644\u0637\u0644\u0628\u060c \u0648\u064a\u064f\u062d\u0641\u0638 \u0627\u0644\u0646\u0635 \u0627\u0644\u0623\u0635\u0644\u064a \u0645\u0634\u0641\u0651\u0631\u064b\u0627 \u0648\u0644\u0627 \u062a\u0641\u062a\u062d\u0647 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0625\u0644\u0627 \u0639\u0646\u062f \u0645\u0634\u0643\u0644\u0629 \u0623\u0648 \u0628\u0644\u0627\u063a.<\/li>\n<li><strong>\u0631\u0627\u0628\u0637 \u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0632\u064a\u0627\u0631\u0629<\/strong> \u064a\u0639\u0631\u0636 \u0631\u0642\u0645 \u0627\u0644\u0637\u0644\u0628 \u0648\u062d\u0627\u0644\u0629 \u0627\u0644\u0632\u064a\u0627\u0631\u0629 \u0648\u0627\u0633\u0645 \u0627\u0644\u0641\u0646\u064a \u0627\u0644\u0623\u0648\u0644 \u0648\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0641\u0642\u0637\u060c \u0628\u0644\u0627 \u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644 \u0623\u0648 \u0639\u0646\u0648\u0627\u0646 \u062a\u0641\u0635\u064a\u0644\u064a \u0623\u0648 \u0645\u0648\u0642\u0639 \u062d\u064a \u0623\u0648 \u0647\u0627\u062a\u0641 \u0623\u0648 \u0633\u0639\u0631. \u064a\u0646\u062a\u0647\u064a \u062e\u0644\u0627\u0644 24 \u0633\u0627\u0639\u0629 \u0643\u062d\u062f \u0623\u0642\u0635\u0649\u060c \u0648\u064a\u062a\u0648\u0642\u0641 \u0628\u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0632\u064a\u0627\u0631\u0629 \u0623\u0648 \u0633\u062d\u0628 \u0627\u0644\u0631\u0627\u0628\u0637.<\/li>\n<li><strong>\u0641\u0631\u064a\u0642 \u0627\u0644\u0625\u062f\u0627\u0631\u0629<\/strong> \u064a\u0631\u0649 \u0645\u0627 \u064a\u0644\u0632\u0645 \u0644\u0644\u062a\u0634\u063a\u064a\u0644 \u0648\u062d\u0644 \u0627\u0644\u0645\u0634\u0643\u0644\u0627\u062a\u060c \u0648\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0644\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0639\u0627\u0645 \u0641\u0642\u0637.<\/li>\n<\/ul>\n<h2>\u0645\u062f\u062f \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638<\/h2>\n<ul>\n<li>\u0627\u0644\u0648\u0633\u0627\u0626\u0637 \u0627\u0644\u0645\u0624\u0642\u062a\u0629 \u063a\u064a\u0631 \u0627\u0644\u0645\u0631\u0641\u0642\u0629 \u0628\u0637\u0644\u0628: 24 \u0633\u0627\u0639\u0629.<\/li>\n<li>\u0646\u0642\u0637\u0629 \u0627\u0644\u0648\u0635\u0648\u0644: 90 \u064a\u0648\u0645\u064b\u0627.<\/li>\n<li>\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0647\u0648\u064a\u0629 \u0627\u0644\u0641\u0646\u064a \u0627\u0644\u0645\u0631\u0641\u0648\u0636: 90 \u064a\u0648\u0645\u064b\u0627 \u0628\u0639\u062f \u0627\u0644\u0631\u0641\u0636 \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u062b\u0645 \u062a\u064f\u062d\u0630\u0641.<\/li>\n<li>\u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0648\u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0648\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a: \u062a\u064f\u062d\u0641\u0638 \u062f\u0627\u0626\u0645\u064b\u0627\u060c \u0648\u062a\u0635\u0628\u062d \u0645\u062c\u0647\u0648\u0644\u0629 \u0627\u0644\u0647\u0648\u064a\u0629 \u0639\u0646\u062f \u062d\u0630\u0641 \u0627\u0644\u062d\u0633\u0627\u0628.<\/li>\n<\/ul>\n<h2>\u062d\u0630\u0641 \u0627\u0644\u062d\u0633\u0627\u0628<\/h2>\n<p>\u064a\u0645\u0643\u0646 \u062d\u0630\u0641 \u0627\u0644\u062d\u0633\u0627\u0628 \u0645\u0646 \u00ab\u062d\u0633\u0627\u0628\u064a\u00bb \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0627 \u0644\u0645 \u064a\u0648\u062c\u062f \u0637\u0644\u0628 \u0646\u0634\u0637. \u0639\u0646\u062f \u0627\u0644\u062d\u0630\u0641 \u062a\u064f\u0632\u0627\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0634\u062e\u0635\u064a\u0629\u060c \u0648\u062a\u0628\u0642\u0649 \u0633\u062c\u0644\u0627\u062a \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0648\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0645\u062c\u0647\u0648\u0644\u0629 \u0627\u0644\u0647\u0648\u064a\u0629.<\/p>\n<h2>\u0627\u0644\u0628\u0631\u064a\u062f \u0648\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a<\/h2>\n<p>\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0628\u0631\u064a\u062f \u0644\u0644\u062a\u0641\u0639\u064a\u0644 \u0648\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0648\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0647\u0645\u0629 \u0644\u0644\u0637\u0644\u0628\u060c \u0648\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0637\u0644\u0628.<\/p>\n<h2>\u0627\u0644\u062a\u0648\u0627\u0635\u0644<\/h2>\n<p>\u0644\u0623\u064a \u0627\u0633\u062a\u0641\u0633\u0627\u0631 \u0639\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a: \u0639\u0628\u0631 \u00ab\u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0648\u0627\u0644\u062f\u0639\u0645\u00bb \u0623\u0648 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062f\u0639\u0645 \u0623\u0633\u0641\u0644 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629.<\/p>","effective_at":"2026-10-14T21:30:10+00:00","web_url":"http:\/\/127.0.0.1:8000\/privacy?locale=ar"}}}