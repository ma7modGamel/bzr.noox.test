<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Bremo.Secondary" />

        <TextView
            android:id="@+id/optional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Bremo.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:addStatesFromChildren="true"
        android:background="@drawable/bremo_bg_field_selector">

        <EditText
            android:id="@+id/edit"
            style="@style/Widget.Bremo.EditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bremo_size_field_height"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:id="@+id/currency"
            android:layout_width="@dimen/bremo_size_currency_box_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/bremo_space_xs"
            android:layout_marginEnd="@dimen/bremo_space_xs"
            android:layout_marginBottom="@dimen/bremo_space_xs"
            android:background="@drawable/bremo_bg_currency_box"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Bremo.Body" />
    </FrameLayout>

    <TextView
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Bremo.Caption"
        android:textColor="@color/bremo_danger"
        android:visibility="gone" />
</merge>
