<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_m"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:showDividers="middle">

        <View
            android:layout_width="@dimen/bremo_size_avatar_small"
            android:layout_height="@dimen/bremo_size_avatar_small"
            android:background="@drawable/bremo_bg_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/bremo_gap_s"
            android:orientation="vertical"
            android:showDividers="middle">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/bremo_size_skeleton_line"
                android:background="@drawable/bremo_bg_skeleton_line" />

            <LinearLayout
                android:id="@+id/shortRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bremo_size_skeleton_line"
                android:orientation="horizontal">

                <View
                    android:id="@+id/shortLine"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bremo_bg_skeleton_line" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
