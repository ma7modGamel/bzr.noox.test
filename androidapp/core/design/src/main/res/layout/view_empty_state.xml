<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">
    <FrameLayout
        android:layout_width="@dimen/bremo_size_avatar_small"
        android:layout_height="@dimen/bremo_size_avatar_small"
        android:background="@drawable/bremo_bg_feedback_empty">

        <noox.bzr.design.views.GradientIconView
            android:id="@+id/emptyIcon"
            android:layout_width="@dimen/bremo_size_icon"
            android:layout_height="@dimen/bremo_size_icon"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Bremo.CardTitle" />

    <TextView
        android:id="@+id/body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Bremo.Secondary" />

    <noox.bzr.design.views.PrimaryButtonView
        android:id="@+id/action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</merge>
