<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">
    <View
        android:layout_width="@dimen/bremo_size_sheet_handle_w"
        android:layout_height="@dimen/bremo_size_sheet_handle_h"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bremo_bg_sheet_handle" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Bremo.SectionTitle" />
    <TextView
        android:id="@+id/body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Bremo.Body" />
    <noox.bzr.design.views.PrimaryButtonView
        android:id="@+id/action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <noox.bzr.design.views.SecondaryButtonView
        android:id="@+id/secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</merge>
