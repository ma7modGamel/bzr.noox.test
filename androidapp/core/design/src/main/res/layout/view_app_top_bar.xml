<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bremo_size_top_bar_height"
        android:paddingVertical="@dimen/bremo_space_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:divider="@drawable/bremo_gap_s"
        android:showDividers="middle">
        <ImageView
            android:id="@+id/back"
            android:layout_width="@dimen/bremo_size_menu_icon_box"
            android:layout_height="@dimen/bremo_size_menu_icon_box"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a11y_back"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/bremo_navy800" />
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Bremo.ScreenTitle" />
        <ImageView
            android:id="@+id/action"
            android:layout_width="@dimen/bremo_size_menu_icon_box"
            android:layout_height="@dimen/bremo_size_menu_icon_box"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:visibility="gone"
            app:tint="@color/bremo_navy800" />
    </LinearLayout>
</merge>
