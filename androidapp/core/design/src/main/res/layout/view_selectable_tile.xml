<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">
    <!-- DEC-070: Figma service tile — icon well, name, one-line hint; the chosen tile adds a check badge. -->
    <FrameLayout
        android:id="@+id/iconWell"
        android:layout_width="@dimen/bremo_size_tile_icon_well"
        android:layout_height="@dimen/bremo_size_tile_icon_well"
        android:background="@drawable/bremo_bg_icon_well">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/bremo_size_tile_icon"
            android:layout_height="@dimen/bremo_size_tile_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_home"
            app:tint="@color/bremo_primary600" />
    </FrameLayout>

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Bremo.TileTitle" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Bremo.Hint"
        android:visibility="gone" />
</merge>
