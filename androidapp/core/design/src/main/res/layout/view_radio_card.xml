<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_m"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:showDividers="middle">

        <FrameLayout
            android:id="@+id/radio"
            android:layout_width="@dimen/bremo_size_radio"
            android:layout_height="@dimen/bremo_size_radio"
            android:background="@drawable/bremo_bg_radio">

            <View
                android:id="@+id/dot"
                android:layout_width="@dimen/bremo_size_radio_dot"
                android:layout_height="@dimen/bremo_size_radio_dot"
                android:layout_gravity="center"
                android:background="@drawable/bremo_dot_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/bremo_gap_xs"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Bremo.CardTitle" />

            <TextView
                android:id="@+id/body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Bremo.Secondary" />
        </LinearLayout>
    </LinearLayout>
</merge>
