<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gallery_component_step_indicator"
        android:textAppearance="@style/TextAppearance.Bremo.SectionTitle" />
    <noox.bzr.design.views.StepIndicatorView
        android:id="@+id/stepIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gallery_component_selectable_tile"
        android:textAppearance="@style/TextAppearance.Bremo.SectionTitle" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_card_gap"
        android:orientation="horizontal"
        android:showDividers="middle">
        <noox.bzr.design.views.SelectableTileView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:bremoText="@string/tile_plumbing"
            app:bremoIcon="@drawable/ic_home"
            app:selectionState="selected"
            android:layout_weight="1" />
        <noox.bzr.design.views.SelectableTileView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:bremoText="@string/tile_electricity"
            app:bremoIcon="@drawable/ic_warning"
            app:selectionState="unselected"
            android:layout_weight="1" />
        <noox.bzr.design.views.SelectableTileView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:bremoText="@string/tile_disabled"
            app:bremoIcon="@drawable/ic_info"
            app:selectionState="disabled"
            android:layout_weight="1" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gallery_component_selectable_chip"
        android:textAppearance="@style/TextAppearance.Bremo.SectionTitle" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_card_gap"
        android:orientation="horizontal"
        android:showDividers="middle">
        <noox.bzr.design.views.SelectableChipView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:bremoText="@string/chip_today"
            app:selectionState="selected"
            android:layout_weight="1" />
        <noox.bzr.design.views.SelectableChipView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:bremoText="@string/chip_tomorrow"
            app:selectionState="unselected"
            android:layout_weight="1" />
        <noox.bzr.design.views.SelectableChipView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:bremoText="@string/chip_unavailable"
            app:selectionState="disabled"
            android:layout_weight="1" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gallery_component_radio_card"
        android:textAppearance="@style/TextAppearance.Bremo.SectionTitle" />
    <noox.bzr.design.views.RadioCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoTitle="@string/radio_now_title"
        app:bremoBody="@string/radio_now_body"
        app:bremoSelected="true" />
    <noox.bzr.design.views.RadioCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoTitle="@string/radio_scheduled_title"
        app:bremoBody="@string/radio_scheduled_body"
        app:bremoSelected="false" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gallery_component_check_row"
        android:textAppearance="@style/TextAppearance.Bremo.SectionTitle" />
    <noox.bzr.design.views.CheckRowView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoText="@string/check_materials"
        app:bremoChecked="true" />
    <noox.bzr.design.views.CheckRowView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bremoText="@string/check_materials"
        app:bremoChecked="false" />
</merge>
