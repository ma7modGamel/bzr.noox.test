<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/bremo_gap_m"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:showDividers="middle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:divider="@drawable/bremo_gap_xs"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:showDividers="middle">

            <TextView
                android:id="@+id/value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Bremo.DisplayNumber" />

            <TextView
                android:id="@+id/unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Bremo.CardTitle"
                android:textColor="@color/bremo_primary700" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/bremo_border_width"
            android:layout_height="@dimen/bremo_size_stat_divider"
            android:background="@color/bremo_border" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/bremo_gap_xs"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Bremo.CardTitle" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Bremo.Secondary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/bremo_size_eta_icon_circle"
            android:layout_height="@dimen/bremo_size_eta_icon_circle"
            android:background="@drawable/bremo_bg_eta_icon">

            <ImageView
                android:layout_width="@dimen/bremo_size_icon"
                android:layout_height="@dimen/bremo_size_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_car"
                app:tint="@color/bremo_primary600" />
        </FrameLayout>
    </LinearLayout>
</merge>
