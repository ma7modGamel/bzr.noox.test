#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
$output = $root.'/reports/batch-6/notifications';
$androidOutput = $output.'/android';
if (! is_dir($androidOutput) && ! mkdir($androidOutput, 0775, true) && ! is_dir($androidOutput)) {
    throw new RuntimeException('Cannot create notifications report output.');
}

// الحالات الجديدة أو المتغيرة في الدفعة 6 فقط؛ باقي لقطات الشاشات الثلاث معتمدة ولم تتغير.
$selected = [
    'SCR-C32' => ['permission_off', 'permission_off_empty', 'provider_mode'],
    'SCR-C33' => ['overview', 'reminders_off', 'success', 'active_order', 'confirm_delete', 'deleting'],
    'SCR-P08' => ['unread_notifications'],
    // إصلاحات المراجعة بعد التشغيل: بيانات حقيقية بدل قيم تجريبية، ونص الحالة الصحيح.
    'SCR-C01' => ['marketplace', 'staff'],
    'SCR-C04' => ['marketplace_now', 'address_missing', 'now_unavailable', 'scheduled_missing'],
    'SCR-C09' => ['confirmed', 'on_the_way', 'approximate', 'arrived', 'in_progress', 'awaiting_quote_approval', 'disputed', 'cancelled', 'open', 'expired', 'offline'],
    'SCR-C26' => ['cash', 'electronic', 'waived', 'unavailable', 'cancelled', 'expired'],
];
$screens = array_keys($selected);
$rows = [];
$count = 0;
foreach ($screens as $screen) {
    $fixture = json_decode(
        (string) file_get_contents($root.'/design/fixtures/'.$screen.'/cases.json'),
        true,
        flags: JSON_THROW_ON_ERROR,
    );
    foreach ($fixture['cases'] as $case) {
        if (! in_array($case['id'], $selected[$screen], true)) {
            continue;
        }
        $id = $screen.'-'.$case['id'];
        $matches = glob($root.'/androidapp/app/src/test/snapshots/images/*_'.strtolower($id).'.png') ?: [];
        if (count($matches) !== 1) {
            throw new RuntimeException("Missing Android snapshot for {$id}");
        }
        $target = 'android/'.$id.'.png';
        copy($matches[0], $output.'/'.$target);
        $rows[] = '<section class="comparison" id="'.htmlspecialchars($id).'">'
            .'<header><strong>'.htmlspecialchars($screen).' · '.htmlspecialchars((string) $case['id']).'</strong>'
            .'<code>'.htmlspecialchars((string) $case['expected']['phase']).'</code></header>'
            .'<div class="columns">'
            .'<article><h2>Android · XML/Paparazzi</h2><a href="'.htmlspecialchars($target).'">'
            .'<img src="'.htmlspecialchars($target).'" alt="'.htmlspecialchars($id).'" loading="lazy"></a></article>'
            .'<article><h2>iOS · SwiftUI</h2><div class="pending">Swift Core وملف SwiftUI متحقق منهما آليًا على Linux؛ الرسم واللقطة مؤجلان لدفعة «تحقق iOS».</div></article>'
            .'</div></section>';
        $count++;
    }
}

$runtimeCaptions = [
    '01-permission-prompt.png' => 'بعد أول دخول: طلب إذن الإشعارات مرة واحدة، ورمز FCM الحقيقي سُجّل في device_tokens على الخادم.',
    '02-c32-permission-off.png' => 'bremo://notifications بعد رفض الإذن: التنبيه ورابط الإعدادات، وإشعار أرسله الخادم ظاهر في القائمة.',
    '03-link-order.png' => 'bremo://orders/1 يفتح شاشة الطلب في وضع العميل.',
    '04-push-tap-provider-link-no-profile.png' => 'محاكاة الضغط على Push برابط فني لحساب بلا ملف فني: يفتح C32 للعميل (AC-NTF-06).',
    '05-c33-reminders.png' => 'C33 بقيمة الخادم: تذكير التقييم مفعّل.',
    '06-c33-reminders-off.png' => 'بعد الإيقاف: rating_reminders_enabled = 0 على الخادم.',
    '07-after-logout.png' => 'بعد الخروج: DELETE /me/devices ثم POST /auth/logout، وعدد رموز الحساب = 0 (AC-NTF-07).',
    '08-c01-real-home.png' => 'بعد الإصلاح: C01 باسم الحساب والطلب الحالي الحقيقي وحالته، والوقت بتوقيت الجهاز.',
    '09-c02-real-account.png' => 'بعد الإصلاح: C02 من GET /me (الاسم، التوثيق، الرقم).',
    '10-c09-open-order.png' => 'بعد الإصلاح: طلب OPEN يظهر «طلب مفتوح» و«طلبك منشور وبانتظار تعيين فني» بدل «تم إلغاء هذا الطلب».',
];
$runtime = '<section class="intro"><h2>أدلة التشغيل — Android على المحاكي</h2></section>';
foreach ($runtimeCaptions as $file => $caption) {
    $runtime .= '<section class="comparison"><header><strong>'.htmlspecialchars($caption).'</strong></header>'
        .'<a href="runtime/'.$file.'"><img src="runtime/'.$file.'" alt="'.htmlspecialchars($file).'" loading="lazy"></a></section>';
}

$html = '<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8">'
    .'<meta name="viewport" content="width=device-width,initial-scale=1"><title>الدفعة 6 — الإشعارات والروابط العميقة</title>'
    .'<link rel="stylesheet" href="../../../design/generated/tokens.css"><style>'
    .'*{box-sizing:border-box}body{margin:0;padding:var(--space-xl);background:var(--color-surfacealt);color:var(--color-navy800);font-family:var(--font-family),sans-serif}'
    .'main{max-width:1100px;margin:auto}.intro,.comparison{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-card);padding:var(--space-l);margin-bottom:var(--space-l)}'
    .'header{display:flex;justify-content:space-between;gap:var(--space-m);align-items:center}.columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-l)}'
    .'img{width:100%;max-width:400px;aspect-ratio:1/2;object-fit:contain;object-position:top;border:1px solid var(--color-border);border-radius:var(--radius-card)}'
    .'.pending{min-height:400px;display:grid;place-items:center;text-align:center;padding:var(--space-l);border:1px dashed var(--color-border);border-radius:var(--radius-card);color:var(--color-slate500)}'
    .'.notice{background:var(--color-primary50info);border-radius:var(--radius-card);padding:var(--space-m)}@media(max-width:800px){.columns{grid-template-columns:1fr}}'
    .'</style></head><body><main><section class="intro"><h1>الدفعة 6 — الإشعارات والروابط العميقة</h1>'
    .'<p>'.$count.' حالة جديدة أو متغيرة: تنبيه الإذن المرفوض ووضع الفني في C32، مفتاح تذكير التقييم في C33، ومدخل الإشعارات بعدد غير المقروء في P08. تحتها أدلة التشغيل على محاكي Pixel_9a.</p>'
    .'<p class="notice"><strong>بوابة الاعتماد:</strong> راجع لقطات Android. لن تبدأ الدفعة 7 (المال) قبل اعتماد هذه الدفعة.</p>'
    .'</section>'.implode("\n", $rows).$runtime.'</main></body></html>';

file_put_contents($output.'/comparison.html', $html);
fwrite(STDOUT, "Generated reports/batch-6/notifications/comparison.html ({$count} snapshots)\n");
