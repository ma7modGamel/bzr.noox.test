#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
$output = $root.'/reports/batch-3b/customer';
$androidOutput = $output.'/android';
$referenceOutput = $output.'/reference';
foreach ([$output, $androidOutput, $referenceOutput] as $directory) {
    if (! is_dir($directory) && ! mkdir($directory, 0775, true) && ! is_dir($directory)) {
        throw new RuntimeException("Cannot create {$directory}");
    }
}

$references = [
    'SCR-C01' => 'C01-home.jpeg',
    'SCR-C02' => 'C02-side-menu.jpeg',
    'SCR-C03' => 'C03-request-step1-service.jpeg',
    'SCR-C04' => 'C04-request-step2-visit.jpeg',
    'SCR-C05' => 'C05-request-step3-review.jpeg',
    'SCR-C06' => 'C06-offers-list.jpeg',
    'SCR-C07' => 'C07-provider-profile.jpeg',
    'SCR-C08' => 'C08-confirm-selection.jpeg',
    'SCR-C09' => 'C09-tracking-on-the-way.jpeg',
];

$rows = [];
$snapshotCount = 0;
foreach ($references as $screen => $reference) {
    copy($root.'/design/reference/'.$reference, $referenceOutput.'/'.$reference);
    $fixture = json_decode((string) file_get_contents($root.'/design/fixtures/'.$screen.'/cases.json'), true, flags: JSON_THROW_ON_ERROR);
    foreach ($fixture['cases'] as $case) {
        if (! $case['snapshot']) {
            continue;
        }
        $snapshotCount++;
        $id = $screen.'-'.$case['id'];
        $matches = glob($root.'/androidapp/app/src/test/snapshots/images/*_'.strtolower($id).'.png') ?: [];
        if (count($matches) !== 1) {
            throw new RuntimeException("Missing Android snapshot for {$id}");
        }
        $target = 'android/'.$id.'.png';
        copy($matches[0], $output.'/'.$target);
        $referenceTarget = 'reference/'.$reference;
        $rows[] = '<section class="comparison" id="'.htmlspecialchars($id).'">'
            .'<header><strong>'.htmlspecialchars($screen).' · '.htmlspecialchars($case['id']).'</strong><code>'.htmlspecialchars($id).'</code></header>'
            .'<div class="columns">'
            .'<article><h2>اللقطة الأصلية</h2><a href="'.htmlspecialchars($referenceTarget).'"><img src="'.htmlspecialchars($referenceTarget).'" alt="'.htmlspecialchars($screen).' original" loading="lazy"></a></article>'
            .'<article><h2>Android · Paparazzi</h2><a href="'.htmlspecialchars($target).'"><img src="'.htmlspecialchars($target).'" alt="'.htmlspecialchars($id).' Android" loading="lazy"></a></article>'
            .'<article><h2>iOS</h2><div class="pending">الكود موجود ومختبر على Linux؛ اللقطة مؤجلة إلى دفعة «تحقق iOS» النهائية وفق DEC-045.</div></article>'
            .'</div></section>';
    }
}

$body = implode("\n", $rows);
$html = <<<HTML
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>الدفعة 3ب — شاشات العميل C01–C09</title>
  <link rel="stylesheet" href="../../../design/generated/tokens.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; padding: var(--space-xl); background: var(--color-surfacealt); color: var(--color-navy800); font-family: var(--font-family), sans-serif; }
    main { max-width: 1320px; margin: auto; }
    .intro, .comparison { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: var(--space-l); margin-bottom: var(--space-l); }
    h1, h2 { color: var(--color-navy900); }
    .notice { background: var(--color-primary50info); border-radius: var(--radius-card); padding: var(--space-m); }
    header { display: flex; justify-content: space-between; gap: var(--space-m); align-items: center; }
    .columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-m); }
    img { width: 100%; max-width: 400px; aspect-ratio: 1 / 2; object-fit: contain; object-position: top; border: 1px solid var(--color-border); border-radius: var(--radius-card); }
    .pending { min-height: 400px; display: grid; place-items: center; text-align: center; padding: var(--space-l); border: 1px dashed var(--color-border); border-radius: var(--radius-card); color: var(--color-slate500); }
    @media (max-width: 900px) { .columns { grid-template-columns: 1fr; } }
  </style>
</head>
<body><main>
  <section class="intro">
    <h1>الدفعة 3ب — C01 إلى C09</h1>
    <p>{$snapshotCount} لقطة Android بحجم 400×800، وكل لقطة بجانب المرجع الأصلي للشاشة.</p>
    <p class="notice"><strong>بوابة الاعتماد:</strong> راجع عمود Android. لن تبدأ 3ج قبل اعتماد هذه الدفعة. لقطات iOS والمقارنة البكسلية مؤجلتان للدفعة النهائية بقرار DEC-045.</p>
  </section>
  {$body}
</main></body></html>
HTML;

file_put_contents($output.'/comparison.html', $html);
fwrite(STDOUT, "Generated reports/batch-3b/customer/comparison.html ({$snapshotCount} snapshots)\n");
