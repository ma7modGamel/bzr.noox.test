/** @return array<string, mixed> */
function readJson(string $path): array
{
    $decoded = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);

    if (! is_array($decoded)) {
        throw new RuntimeException("Expected JSON object: {$path}");
    }

    return $decoded;
}

function androidName(string $key): string
{
    return trim((string) preg_replace('/[^a-z0-9]+/', '_', strtolower($key)), '_');
}

function codeName(string $key): string
{
    $parts = preg_split('/[^A-Za-z0-9]+/', $key) ?: [];
    $first = array_shift($parts) ?? '';

    return lcfirst($first.implode('', array_map(static fn (string $part): string => ucfirst($part), $parts)));
}

function xml(string $value): string
{
    return htmlspecialchars($value, ENT_XML1 | ENT_QUOTES, 'UTF-8');
}

/** Android string resources treat ' and " and a leading @ or ? specially. */
function androidString(string $value): string
{
    $escaped = str_replace(['\\', "'", '"'], ['\\\\', "\\'", '\\"'], $value);

    return xml($escaped);
}

function colorHex(mixed $token): string
{
    if (is_string($token)) {
        return $token;
    }

    if (is_array($token) && isset($token['hex'])) {
        $alpha = (int) round(((float) ($token['alpha'] ?? 1)) * 255);

        return '#'.strtoupper(str_pad(dechex($alpha), 2, '0', STR_PAD_LEFT)).substr((string) $token['hex'], 1);
    }

    throw new RuntimeException('Invalid color token.');
}

function argb(string $hex): string
{
    $raw = strtoupper(ltrim($hex, '#'));

    return strlen($raw) === 8 ? $raw : 'FF'.$raw;
}

function swiftColor(string $hex): string
{
    $raw = argb($hex);
    $alpha = hexdec(substr($raw, 0, 2)) / 255;
    $red = hexdec(substr($raw, 2, 2)) / 255;
    $green = hexdec(substr($raw, 4, 2)) / 255;
    $blue = hexdec(substr($raw, 6, 2)) / 255;

    return sprintf('Color(red: %.4f, green: %.4f, blue: %.4f, opacity: %.4f)', $red, $green, $blue, $alpha);
}

/** Numbers are written without a trailing ".0" so dp/pt literals stay readable. */
function num(int|float $value): string
{
    return is_float($value) && floor($value) !== $value ? rtrim(rtrim(sprintf('%.4f', $value), '0'), '.') : (string) (int) $value;
}

/**
 * Rewrites SVG path data into a canonical, fully separated form.
 * Arc flags may legally be packed ("a4 4 0 100-8"); Android's PathParser misreads that,
 * so every platform receives the same unpacked path.
 */
function normalizePath(string $data): string
{
    $arity = ['M' => 2, 'L' => 2, 'H' => 1, 'V' => 1, 'C' => 6, 'S' => 4, 'Q' => 4, 'T' => 2, 'A' => 7, 'Z' => 0];
    $length = strlen($data);
    $position = 0;
    $result = [];

    $skip = static function () use (&$position, $data, $length): void {
        while ($position < $length && (ctype_space($data[$position]) || $data[$position] === ',')) {
            $position++;
        }
    };
    $number = static function () use (&$position, $data): string {
        if (! preg_match('/\G[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?/', $data, $match, 0, $position)) {
            throw new RuntimeException("Invalid path number at {$position}: {$data}");
        }
        $position += strlen($match[0]);

        return $match[0];
    };

    $skip();
    while ($position < $length) {
        $command = $data[$position];
        if (! isset($arity[strtoupper($command)])) {
            throw new RuntimeException("Unsupported path command '{$command}' in: {$data}");
        }
        $position++;
        $count = $arity[strtoupper($command)];
        $result[] = $command;

        if ($count === 0) {
            $skip();

            continue;
        }

        do {
            $arguments = [];
            for ($index = 0; $index < $count; $index++) {
                $skip();
                $isFlag = strtoupper($command) === 'A' && ($index === 3 || $index === 4);
                if ($isFlag) {
                    if (! in_array($data[$position] ?? '', ['0', '1'], true)) {
                        throw new RuntimeException("Invalid arc flag at {$position}: {$data}");
                    }
                    $arguments[] = $data[$position++];
                } else {
                    $arguments[] = $number();
                }
            }
            $result[] = implode(' ', $arguments);
            $skip();
        } while ($position < $length && preg_match('/[-+.\d]/', $data[$position]));
    }

    return implode(' ', $result);
}

/** @param array<string, string> $outputs */
function syncText(string $root, string $relativePath, string $content, bool $checkOnly, array &$errors, array &$outputs): void
{
    $outputs[$relativePath] = hash('sha256', $content);
    $path = $root.'/'.$relativePath;

    if ($checkOnly) {
        if (! is_file($path) || file_get_contents($path) !== $content) {
            $errors[] = $relativePath;
        }

        return;
    }

    $directory = dirname($path);
    if (! is_dir($directory) && ! mkdir($directory, 0775, true) && ! is_dir($directory)) {
        throw new RuntimeException("Cannot create {$directory}");
    }

    file_put_contents($path, $content);
}

/** @param array<string, string> $outputs */
function syncBinary(string $root, string $source, string $relativePath, bool $checkOnly, array &$errors, array &$outputs): void
{
    syncText($root, $relativePath, (string) file_get_contents($source), $checkOnly, $errors, $outputs);
