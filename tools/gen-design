    $svg = (string) file_get_contents($iconFile);
    if (preg_match_all('/<path\b/', $svg) !== 1 || ! preg_match('/<path d="([^"]+)"\/>/', $svg, $matches)) {
        throw new RuntimeException("Icon {$name} must contain exactly one self-closing path.");
    }
    if (! str_contains($svg, 'viewBox="0 0 '.$iconViewport.' '.$iconViewport.'"')) {
        throw new RuntimeException("Icon {$name} must use a {$iconViewport}x{$iconViewport} viewBox.");
    }

    $pathData = normalizePath($matches[1]);
    $filled = str_contains($svg, 'fill="currentColor"');
    $evenOdd = str_contains($svg, 'fill-rule="evenodd"');
    // iOS receives a canonical SVG: explicit colours on the path, no currentColor, no inherited attributes.
    $svgPaint = $filled
        ? 'fill="#'.substr($iconColor, 2).'"'.($evenOdd ? ' fill-rule="evenodd"' : '')
        : 'fill="none" stroke="#'.substr($iconColor, 2).'" stroke-width="'.$iconStroke.'" stroke-linecap="round" stroke-linejoin="round"';
    $canonicalSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '.$iconViewport.' '.$iconViewport.'" width="'.$iconViewport.'" height="'.$iconViewport.'">'."\n".
        '  <path d="'.$pathData.'" '.$svgPaint.'/>'."\n</svg>\n";

    $paint = $filled
        ? 'android:fillColor="#'.$iconColor.'"'.($evenOdd ? ' android:fillType="evenOdd"' : '')
        : 'android:fillColor="@android:color/transparent" android:strokeColor="#'.$iconColor.'" android:strokeWidth="'.$iconStroke.'" android:strokeLineCap="round" android:strokeLineJoin="round"';
    $mirroring = in_array($name, ['arrow-back', 'chevron'], true) ? ' android:autoMirrored="true"' : '';
